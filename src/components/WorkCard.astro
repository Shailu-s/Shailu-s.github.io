---
interface Props {
  href: string;
  index: number;
  title: string;
  kicker: string;
  summary: string;
  metrics: { value: string; label: string }[];
  stack: string[];
  code?: { label: string; href: string };
}
const { href, index, title, kicker, summary, metrics, stack, code } = Astro.props;
---

<article class="card">
  <div class="top">
    <span class="eyebrow"><b>{String(index).padStart(2, '0')}</b> &nbsp;{kicker}</span>
    {
      code ? (
        <a class="code mono" href={code.href} target="_blank" rel="noopener" aria-label={`Source code: ${code.label}`}>
          <svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
          Code <span class="arrow">↗</span>
        </a>
      ) : (
        <span class="private mono">private code</span>
      )
    }
  </div>
  <h3><a class="stretch" href={href}>{title}</a></h3>
  <p>{summary}</p>
  {
    metrics.length > 0 && (
      <dl>
        {metrics.slice(0, 3).map((m) => (
          <div>
            <dt class="mono">{m.value}</dt>
            <dd>{m.label}</dd>
          </div>
        ))}
      </dl>
    )
  }
  <div class="bottom">
    <ul class="tags">{stack.slice(0, 6).map((t) => <li>{t}</li>)}</ul>
    <span class="go mono" aria-hidden="true">case study <span class="arrow">→</span></span>
  </div>
</article>

<style>
  .card {
    position: relative; padding: 22px 24px 24px; border-radius: 14px;
    border: 1px solid transparent;
    transition: background 0.2s, border-color 0.2s;
  }
  .card:hover { background: var(--bg-hover); border-color: var(--line); }
  .top { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .code, .private {
    position: relative; z-index: 1; display: inline-flex; align-items: center; gap: 6px;
    font-size: 12px; padding: 4px 10px; border-radius: 999px; border: 1px solid var(--line-strong);
  }
  .code { color: var(--text); }
  .code:hover { color: var(--accent); border-color: var(--accent); }
  .private { color: var(--text-faint); border-style: dashed; }
  h3 { font-size: 20px; margin: 10px 0 8px; }
  .stretch { color: var(--text); }
  .stretch::after { content: ''; position: absolute; inset: 0; border-radius: 14px; }
  .card:hover .stretch { color: var(--accent); }
  p { margin: 0 0 16px; font-size: 15.5px; }
  dl { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin: 0 0 18px; }
  dl div { border-left: 1px solid var(--line-strong); padding-left: 12px; }
  dt { color: var(--text); font-size: 17px; font-weight: 500; }
  dd { margin: 2px 0 0; font-size: 12.5px; line-height: 1.4; color: var(--text-faint); }
  .bottom { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .go { font-size: 12px; color: var(--text-faint); white-space: nowrap; transition: color 0.2s; }
  .card:hover .go { color: var(--accent); }
  @media (max-width: 640px) {
    .card { padding: 18px 4px; }
    .card:hover { background: none; border-color: transparent; }
    .go { display: none; }
    dl { grid-template-columns: 1fr 1fr; }
  }
</style>
