---
interface Props {
  steps: { label: string; detail?: string }[];
  caption?: string;
}
const { steps, caption } = Astro.props;
---

<figure class="flow">
  <ol style={`--n: ${steps.length}`}>
    {
      steps.map((s, i) => (
        <li>
          <span class="n mono">{String(i + 1).padStart(2, '0')}</span>
          <strong>{s.label}</strong>
          {s.detail && <span class="d">{s.detail}</span>}
        </li>
      ))
    }
  </ol>
  {caption && <figcaption class="eyebrow">{caption}</figcaption>}
</figure>

<style>
  .flow { margin: 0; }
  ol {
    list-style: none; padding: 0; margin: 0;
    display: grid; grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    gap: 24px;
  }
  li {
    position: relative; padding: 14px 14px 16px;
    background: var(--bg-raised); border: 1px solid var(--line); border-radius: var(--radius);
    display: flex; flex-direction: column; gap: 6px;
  }
  li:not(:last-child)::after {
    content: '→'; position: absolute; right: -19px; top: 50%; transform: translateY(-50%);
    font-family: var(--mono); color: var(--accent); font-size: 14px;
  }
  .n { font-size: 11px; color: var(--accent); }
  strong { color: var(--text); font-size: 14px; font-weight: 600; line-height: 1.3; }
  .d { font-size: 12.5px; line-height: 1.45; color: var(--text-dim); }
  figcaption { margin-top: 14px; }
  @media (max-width: 760px) {
    ol { grid-template-columns: 1fr; gap: 26px; }
    li:not(:last-child)::after { content: '↓'; right: auto; left: 22px; top: auto; bottom: -24px; transform: none; }
  }
</style>
